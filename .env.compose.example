# Variables del despliegue con Docker Compose (docker-compose.yml).
# Copia este archivo como .env.compose y cambia los valores. .env.compose NO se versiona.

# Base de datos (contenedor db, sin puerto publicado)
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=ecommerce

# Autenticación. Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_64_caracteres
JWT_EXPIRES_IN=2h

# Administrador que crea el seed (npm run deploy:demo). Nombres con prefijo SEED_ para que no los pisen
# variables ADMIN_EMAIL/ADMIN_PASSWORD que existan en el sistema (en la interpolación, el sistema manda).
SEED_ADMIN_EMAIL=admin@tienda.com
SEED_ADMIN_PASSWORD=Admin12345

# URL públicas tal como las ve el navegador (API_URL es el origen, sin /api)
WEB_URL=http://localhost:8080
API_URL=http://localhost:3000

# Chatbot (groq | gemini | reglas). Sin key, responde el proveedor de reglas.
CHAT_PROVEEDOR=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=
